# Required: 13-word Session recovery password for the bot account
SESSION_MNEMONIC="your 13 word mnemonic here"

# Required: only this Session ID can message the bot
OWNER_SESSION_ID=05abc...

# Required: OpenCode Go API key
OPENCODE_API_KEY=...
OPENCODE_GO_API_KEY=...

# AI model (OpenCode Go)
MODEL=opencode-go/deepseek-v4-pro

# AI engine: openclaw or hermes
BACKEND=openclaw
